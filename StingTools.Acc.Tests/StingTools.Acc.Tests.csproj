<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <!-- Pure-logic + loopback test project. Does NOT reference the Revit API or WPF; it
         links the Revit-free ACC clients via <Compile Include>, the same pattern
         StingTools.Visibility.Tests and StingTools.Clash.Tests use.

         Why this project exists: before it, the entire ACC surface (four HTTP clients,
         a 3-legged OAuth flow, the KUT coordination cycle's read path) had ZERO tests,
         and two of its defects were exactly the kind a test catches and a reading does
         not — a 404 that rendered as "no clashes", and a retry loop that could not
         execute because HttpRequestMessage is single-use. -->
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- Same version as the main plugin, so a Newtonsoft behaviour difference cannot
         make a test pass that the plugin would fail. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- The outcome discriminator: Revit-free AND log-free on purpose, so the mapping
         (HTTP status + parsed count -> Ok / EmptyOk / AuthFailed / NotFound /
         TransportFailed) is testable on its own. -->
    <Compile Include="..\StingTools\V6\AccFetchOutcome.cs" Link="V6\AccFetchOutcome.cs" />
    <!-- The real clients. A pure-function test alone would be an alternative-path escape:
         it would not catch the CLIENT mapping a 404 to an empty list, which is the actual
         defect. So the real transports are linked and driven over a loopback listener. -->
    <Compile Include="..\StingTools\V6\AccModelCoordSync.cs" Link="V6\AccModelCoordSync.cs" />
    <Compile Include="..\StingTools\V6\AccIssueSync.cs" Link="V6\AccIssueSync.cs" />
    <!-- TestHelpers/StingLogShim.cs is picked up by the SDK's default Compile glob;
         StingTools/Core/StingLog.cs cannot be linked (it drags in StingTools.Core.Drawing). -->
  </ItemGroup>

</Project>
