<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <!-- Pure-logic + loopback test project. Does NOT reference the Revit API or WPF; it
         links the Revit-free ACC clients via <Compile Include>, the same pattern
         StingTools.Visibility.Tests and StingTools.Clash.Tests use.

         Why this project exists: before it, the entire ACC surface (four HTTP clients,
         a 3-legged OAuth flow, the KUT coordination cycle's read path) had ZERO tests,
         and two of its defects were exactly the kind a test catches and a reading does
         not — a 404 that rendered as "no clashes", and a retry loop that could not
         execute because HttpRequestMessage is single-use. -->
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Nullable>disable</Nullable>
    <!-- PlanscapeProtocol.cs (linked below) also holds the HKCU protocol registration. The
         tests never call it; CA1416 only says Registry is Windows-only, which the plugin is. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- Same version as the main plugin, so a Newtonsoft behaviour difference cannot
         make a test pass that the plugin would fail. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The outcome discriminator: Revit-free AND log-free on purpose, so the mapping
         (HTTP status + parsed count -> Ok / EmptyOk / AuthFailed / NotFound /
         TransportFailed) is testable on its own. -->
    <Compile Include="..\StingTools\V6\AccFetchOutcome.cs" Link="V6\AccFetchOutcome.cs" />
    <Compile Include="..\StingTools\V6\AccProjectDiscovery.cs" Link="V6\AccProjectDiscovery.cs" />
    <!-- The command DECISION, extracted out of the Revit-bound commands so the branch that
         makes the whole outcome split matter (Result.Failed instead of Succeeded) is
         covered by a test rather than by reading. -->
    <Compile Include="..\StingTools\V6\AccCommandOutcome.cs" Link="V6\AccCommandOutcome.cs" />
    <!-- The prompt/no-prompt decision for the whole ACC cycle, plus the two pure
         resolutions that used to be dialogs (which model set, which clashes to escalate).
         These are Revit UI seams, and you cannot assert "no TaskDialog appeared" in a
         headless test - so the DECISION is extracted and the command only shows UI when
         the decision says to. ClashTriageEngine is linked for ScoredClash. -->
    <Compile Include="..\StingTools\V6\AccOperatingPolicy.cs" Link="V6\AccOperatingPolicy.cs" />
    <Compile Include="..\StingTools\V6\AccProjectScope.cs" Link="V6\AccProjectScope.cs" />
    <Compile Include="..\StingTools\V6\ClashTriageEngine.cs" Link="V6\ClashTriageEngine.cs" />
    <!-- The real clients. A pure-function test alone would be an alternative-path escape:
         it would not catch the CLIENT mapping a 404 to an empty list, which is the actual
         defect. So the real transports are linked and driven over a loopback listener. -->
    <Compile Include="..\StingTools\V6\AccModelCoordSync.cs" Link="V6\AccModelCoordSync.cs" />
    <Compile Include="..\StingTools\V6\AccIssueSync.cs" Link="V6\AccIssueSync.cs" />
    <!-- A5: the record ACCPublish writes so ACC_UploadLastBundle can upload the bundle it
         built without a human picking a file. The "is the file still there?" rule is the
         difference between a file choice and a guess, so it is tested. -->
    <Compile Include="..\StingTools\V6\AccBundleRecord.cs" Link="V6\AccBundleRecord.cs" />
    <!-- A6: the uploader, so a 403 on storage creation can be proved to surface as an
         auth-kind failure rather than a bare Ok=false. -->
    <Compile Include="..\StingTools\V6\AccModelUpload.cs" Link="V6\AccModelUpload.cs" />
    <!-- ACC_ImportIssues: the ACC -> STING issue-register merge, and the two pure halves of
         the register it writes through (schema + status vocabulary). -->
    <Compile Include="..\StingTools\V6\AccIssueImport.cs" Link="V6\AccIssueImport.cs" />
    <Compile Include="..\StingTools\V6\AccHttp.cs" Link="V6\AccHttp.cs" />
    <Compile Include="..\StingTools\V6\AccCredentialStore.cs" Link="V6\AccCredentialStore.cs" />
    <Compile Include="..\StingTools\V6\AccIds.cs" Link="V6\AccIds.cs" />
    <Compile Include="..\StingTools\V6\AccDisciplineResolver.cs" Link="V6\AccDisciplineResolver.cs" />
    <Compile Include="..\StingTools\V6\AccOAuthFlow.cs" Link="V6\AccOAuthFlow.cs" />
    <Compile Include="..\StingTools\V6\AccUploadResume.cs" Link="V6\AccUploadResume.cs" />
    <!-- The failOnError step flag and the KUT cycle that relies on it. -->
    <Compile Include="..\StingTools\Core\WorkflowPresetModel.cs" Link="Core\WorkflowPresetModel.cs" />
    <!-- ACC-DOCS: CDE-folder routing by suitability + ACC Docs custom attributes. Routing
         reuses the one suitability -> CDE state mapping (Iso19650Suitability, Revit-free),
         so the test proves the upload files by the same rule the title block prints. -->
    <Compile Include="..\StingTools\Core\Drawing\Iso19650Suitability.cs" Link="Core\Drawing\Iso19650Suitability.cs" />
    <Compile Include="..\StingTools\V6\AccCdeRouting.cs" Link="V6\AccCdeRouting.cs" />
    <Compile Include="..\StingTools\V6\AccDocsMetadata.cs" Link="V6\AccDocsMetadata.cs" />
    <!-- ACC_SelfCheck: every decision the go-live check makes (PASS / WARN / FAIL / SKIPPED),
         driven over loopback against the real clients above. -->
    <Compile Include="..\StingTools\V6\AccSelfCheck.cs" Link="V6\AccSelfCheck.cs" />
    <!-- ACC-HARD-5: locating an escalated clash (dbId -> Revit UniqueId via Model Derivative,
         ACC viewer link via Data Management), the planscape://revit/select link it carries,
         and the BCF attachment (written by the shared BcfEngine). -->
    <Compile Include="..\StingTools\V6\AccClashLocate.cs" Link="V6\AccClashLocate.cs" />
    <Compile Include="..\StingTools\V6\AccIssueAttachment.cs" Link="V6\AccIssueAttachment.cs" />
    <Compile Include="..\StingTools\Core\PlanscapeProtocol.cs" Link="Core\PlanscapeProtocol.cs" />
    <Compile Include="..\StingTools\BIMManager\BcfEngine.cs" Link="BIMManager\BcfEngine.cs" />
    <Compile Include="..\StingTools\Core\IssueSchema.cs" Link="Core\IssueSchema.cs" />
    <Compile Include="..\StingTools\Core\IssueStatusNormalizer.cs" Link="Core\IssueStatusNormalizer.cs" />
    <!-- Export -> register -> ACC: the one suitability/revision resolver (with its XX / NOREV
         not-set markers), the per-file upload facts (bundle record / register row, refusal of
         a not-set file) and the upload ledger (identical skip, re-issue-without-revision
         refusal). The register row mapper is the plugin's own. -->
    <Compile Include="..\StingTools\Core\Drawing\ExportIsoFields.cs" Link="Core\Drawing\ExportIsoFields.cs" />
    <Compile Include="..\StingTools\V6\AccFileIsoFacts.cs" Link="V6\AccFileIsoFacts.cs" />
    <Compile Include="..\StingTools\V6\AccUploadLedger.cs" Link="V6\AccUploadLedger.cs" />
    <!-- 7-field naming + the folder naming-standard pre-check the uploader runs. -->
    <Compile Include="..\StingTools\V6\AccNamingStandard.cs" Link="V6\AccNamingStandard.cs" />
    <Compile Include="..\StingTools\Core\DocumentRegisterMerge.cs" Link="Core\DocumentRegisterMerge.cs" />
    <Compile Include="..\StingTools\Core\DocumentIdentity.cs" Link="Core\DocumentIdentity.cs" />
    <!-- TestHelpers/StingLogShim.cs is picked up by the SDK's default Compile glob;
         StingTools/Core/StingLog.cs cannot be linked (it drags in StingTools.Core.Drawing). -->
  </ItemGroup>

</Project>
