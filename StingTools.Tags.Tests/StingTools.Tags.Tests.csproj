<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <!-- Pure-logic test project. Does NOT reference Revit API or WPF. Instead,
         links the pure-logic .cs files from the main StingTools project via
         <Compile Include>, avoiding the need for Revit DLLs on the test host.
         Mirrors StingTools.Clash.Tests. -->
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The shipped data the COBie map is asserted against. A map validated only
         against itself is the blind spot the LOD matrix already had: eleven COBie
         targets named parameters that do not exist, and every one of those columns
         was read from the spreadsheet and discarded in silence. -->
    <None Include="..\StingTools\Data\PARAMETER_REGISTRY.json" Link="Data\PARAMETER_REGISTRY.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\StingTools\Data\RESOLVED_BINDINGS.csv" Link="Data\RESOLVED_BINDINGS.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\StingTools\Data\MR_PARAMETERS.txt" Link="Data\MR_PARAMETERS.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- KUT-11: the two classification maps, asserted against the resolvers that read
         them. Not copied to the output — SystemFamilyFallbackTests walks up to
         StingTools/Data so a stale copy cannot pass while the shipped file is wrong. -->
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- Same version as the main plugin to avoid transitive mismatch. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- The units under test — all have zero Autodesk.Revit.* dependencies,
         so they compile cleanly against net8.0 with no shims. -->
    <!-- Coordination-log wire format. Revit-free by design so the JSONL contract is
         testable outside Revit. -->
    <Compile Include="..\StingTools\Core\CoordLogFormat.cs" Link="Core\CoordLogFormat.cs" />
    <!-- IM Phase 3 warning-snapshot codec: pure JSON + payload shaping, no Revit,
         so the server DTO contract can be asserted without a Revit host. -->
    <Compile Include="..\StingTools\Core\WarningSnapshotFormat.cs" Link="Core\WarningSnapshotFormat.cs" />
    <!-- Issue register: canonical schema + id minting + status vocabulary. Kept Revit-free
         so the schema-fork migration and the duplicate-id regression are testable outside
         Revit. The Revit-facing repository (Core/IssueStore.cs) is not linked here — it
         needs a Document for path resolution. -->
    <Compile Include="..\StingTools\Core\IssueSchema.cs" Link="Core\IssueSchema.cs" />
    <Compile Include="..\StingTools\Core\IssueStatusNormalizer.cs" Link="Core\IssueStatusNormalizer.cs" />
    <Compile Include="..\StingTools\Core\SeqAssigner.cs" Link="Core\SeqAssigner.cs" />
    <Compile Include="..\StingTools\Core\SeqBlockReservation.cs" Link="Core\SeqBlockReservation.cs" />
    <Compile Include="..\StingTools\Core\Validation\ProgramAuditEngine.cs" Link="Core\Validation\ProgramAuditEngine.cs" />
    <!-- WI-7: the Revit-free half of the LOD engine — matrix model, "*"-fallback
         resolution and the pass/fail/SKIP tally. Split out of
         LodVerificationEngine.cs (which needs a Document) precisely so the
         "an empty scope is not a green gate" rule is provable here. -->
    <Compile Include="..\StingTools\Core\Validation\LodMatrixModel.cs" Link="Core\Validation\LodMatrixModel.cs" />
    <Compile Include="..\StingTools\Core\Validation\DateFormatRule.cs" Link="Core\Validation\DateFormatRule.cs" />
    <Compile Include="..\StingTools\Core\Cobie\CobieFieldMap.cs" Link="Core\Cobie\CobieFieldMap.cs" />
    <Compile Include="..\StingTools\Docs\ReviewCommentTracker.cs" Link="Docs\ReviewCommentTracker.cs" />
    <Compile Include="..\StingTools\Core\Classification\CsiMasterFormat.cs" Link="Core\Classification\CsiMasterFormat.cs" />
    <!-- KUT-5: the Revit-free phase classification the Division 02 rule keys on. -->
    <Compile Include="..\StingTools\Core\Classification\ElementPhaseState.cs" Link="Core\Classification\ElementPhaseState.cs" />
    <Compile Include="..\StingTools\Core\Validation\DeviceCoordination.cs" Link="Core\Validation\DeviceCoordination.cs" />
    <Compile Include="..\StingTools\Core\Hvac\LifeCycleCostEngine.cs" Link="Core\Hvac\LifeCycleCostEngine.cs" />
    <Compile Include="..\StingTools\Core\ScopeBoxLoc.cs" Link="Core\ScopeBoxLoc.cs" />
    <Compile Include="..\StingTools\Core\ProdPatternMatcher.cs" Link="Core\ProdPatternMatcher.cs" />
    <Compile Include="..\StingTools\Core\ProdResolver.cs" Link="Core\ProdResolver.cs" />
    <!-- BS EN ISO 22014 name parsing. Revit-free so the "declared" tier is provable. -->
    <Compile Include="..\StingTools\Core\ProdNameCode.cs" Link="Core\ProdNameCode.cs" />
    <!-- The house-standard catalogue POCOs, so the shipped baseline is checked
         against the rules that must read it. -->
    <Compile Include="..\StingTools\Core\Baseline\ProjectBaselineModel.cs" Link="Core\Baseline\ProjectBaselineModel.cs" />
    <Compile Include="..\StingTools\Core\MaterialSchedule\FinishTextClassifier.cs" Link="Core\MaterialSchedule\FinishTextClassifier.cs" />
    <!-- The shared "not a thing" mechanism + the PROD policy that loads it. Kept
         Revit-free so the shipped exclusion list is asserted against the real
         model counts that exposed the 0.8%-vs-3.1% denominator. -->
    <Compile Include="..\StingTools\Core\ProductExclusion.cs" Link="Core\ProductExclusion.cs" />
    <Compile Include="..\StingTools\Core\ProdExclusionPolicy.cs" Link="Core\ProdExclusionPolicy.cs" />
    <!-- The Revit-free half of the material-driven PROD suffix. Split out of
         MaterialProdOverrideRegistry (which needs an Element) so the SHIPPED rule
         table is assertable: an unanchored stem handed sheep's wool an EPS code. -->
    <Compile Include="..\StingTools\Core\MaterialProdOverrideRules.cs" Link="Core\MaterialProdOverrideRules.cs" />
    <!-- Which layer of a compound element NAMES it. Revit-free so the choice is
         testable: every defect here has been a wrong choice, not a failed read. -->
    <Compile Include="..\StingTools\Core\PrimaryMaterialSelector.cs" Link="Core\PrimaryMaterialSelector.cs" />
    <!-- The two bulk standardisation planners. Revit-free so the REFUSALS - the
         half that makes them safe on a delivered model - are provable. -->
    <Compile Include="..\StingTools\Core\Baseline\TypeRenamePlanner.cs" Link="Core\Baseline\TypeRenamePlanner.cs" />
    <Compile Include="..\StingTools\Core\Materials\MaterialClassPlanner.cs" Link="Core\Materials\MaterialClassPlanner.cs" />
    <!-- IM-15: config-driven revision scheme. Kept Revit-free so the P→C default and the
         per-appointment override are provable without a Revit host. -->
    <Compile Include="..\StingTools\Docs\Templates\RevisionScheme.cs" Link="Docs\Templates\RevisionScheme.cs" />
    <!-- IM-13: the shared document-identity rule and the register merge core. Both kept
         Revit-free so the cross-store dedup regression (a trailing space forking one
         document into two rows) is provable without a Revit host. -->
    <Compile Include="..\StingTools\Core\DocumentIdentity.cs" Link="Core\DocumentIdentity.cs" />
    <Compile Include="..\StingTools\Core\DocumentRegisterMerge.cs" Link="Core\DocumentRegisterMerge.cs" />
  </ItemGroup>

</Project>
