<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <!-- Pure-logic test project. Does NOT reference Revit API or WPF. Instead,
         links the pure-logic .cs files from the main StingTools project via
         <Compile Include>, avoiding the need for Revit DLLs on the test host.
         Mirrors StingTools.Clash.Tests. -->
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The shipped data the COBie map is asserted against. A map validated only
         against itself is the blind spot the LOD matrix already had: eleven COBie
         targets named parameters that do not exist, and every one of those columns
         was read from the spreadsheet and discarded in silence. -->
    <None Include="..\StingTools\Data\PARAMETER_REGISTRY.json" Link="Data\PARAMETER_REGISTRY.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\StingTools\Data\RESOLVED_BINDINGS.csv" Link="Data\RESOLVED_BINDINGS.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\StingTools\Data\MR_PARAMETERS.txt" Link="Data\MR_PARAMETERS.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- The ACTUAL shipped token policy, not a copy. TagTokenPolicyTests round-trips it,
         so a Newtonsoft silent default in it fails here rather than mid-batch in Revit.
         This file was read by NOTHING between 2026-08-10 and 2026-09-15; a test that
         parses it is the cheapest guarantee that it stays wired. -->
    <None Include="..\StingTools\Data\STING_TAG_TOKEN_POLICY.json" Link="Data\STING_TAG_TOKEN_POLICY.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\StingTools\Data\STING_SHEET_DISCIPLINES.json" Link="Data\STING_SHEET_DISCIPLINES.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- KUT-11: the two classification maps, asserted against the resolvers that read
         them. Not copied to the output — SystemFamilyFallbackTests walks up to
         StingTools/Data so a stale copy cannot pass while the shipped file is wrong. -->
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- Same version as the main plugin to avoid transitive mismatch. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

