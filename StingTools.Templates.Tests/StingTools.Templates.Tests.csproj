<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.6.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.4" />
    <!-- Same renderer the plugin uses, so the loop-expansion test exercises the
         real engine rather than a model of it. -->
    <PackageReference Include="MiniWord" Version="0.9.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The shipped template pack, copied to the output so the tests run against
         the real .docx files rather than fixtures that can drift from them. -->
    <None Include="..\StingTools\Docs\_template_sources\*.docx"
          Link="_template_sources\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
