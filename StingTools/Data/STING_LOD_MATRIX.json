        "300": { "requireGeometry": true, "forbidPlaceholderFamilies": true, "requireTypeNotGeneric": true, "requiredParams": ["ASS_TAG_1_TXT"] },
        "350": { "inherit": "300", "requiredParams": ["+ASS_PRODCT_COD_TXT"] },
        "400": { "inherit": "350", "requiredParams": ["+ASS_MODEL_REF_TXT"], "requireManufacturerType": true },
        "500": { "inherit": "400", "requiredParams": ["+ASS_INSTALLATION_DATE_TXT"] }
      }
