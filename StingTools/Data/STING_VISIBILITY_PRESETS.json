{
  "version": 1,
  "description": "STING Visibility Center — corporate baseline presets. Project-scoped presets layer on top from <project>/_BIM_COORD/visibility_presets.json and win by name. Categories may be named by BuiltInCategory ('OST_DuctCurves'); the plugin resolves the id and display name at load, so this file stays readable and Revit-version safe.",
  "presets": [
    {
      "name": "Zone isolation",
      "mode": "Temporary",
      "target": "ActiveView",
      "description": "Show only the elements in one zone. Edit the ZONE value to the zone you are working in.",
      "rules": [
        {
          "kind": "Token",
          "tokenKey": "ZONE",
          "values": [ "Z01" ],
          "action": "ShowOnly"
        }
      ]
    },
    {
      "name": "Discipline solo",
      "mode": "Temporary",
      "target": "ActiveView",
      "description": "Show only one discipline's elements — the coordination equivalent of soloing a track.",
      "rules": [
        {
          "kind": "Token",
          "tokenKey": "DISC",
          "values": [ "M" ],
          "action": "ShowOnly"
        }
      ]
    },
    {
      "name": "Hide untagged",
      "mode": "Temporary",
      "target": "ActiveView",
      "description": "Hide everything that has no discipline token yet, leaving only tagged work visible.",
      "rules": [
        {
          "kind": "Token",
          "tokenKey": "DISC",
          "values": [ "(unset)" ],
          "action": "Hide"
        }
      ]
    },
    {
      "name": "MEP only",
      "mode": "Temporary",
      "target": "ActiveView",
      "description": "Show only mechanical, electrical and public-health categories.",
      "rules": [
        { "kind": "Category", "categoryName": "OST_DuctCurves",           "action": "ShowOnly" },
        { "kind": "Category", "categoryName": "OST_DuctFitting",          "action": "ShowOnly" },
        { "kind": "Category", "categoryName": "OST_DuctTerminal",         "action": "ShowOnly" },
        { "kind": "Category", "categoryName": "OST_FlexDuctCurves",       "action": "ShowOnly" },
        { "kind": "Category", "categoryName": "OST_PipeCurves",           "action": "ShowOnly" },
        { "kind": "Category", "categoryName": "OST_PipeFitting",          "action": "ShowOnly" },
        { "kind": "Category", "categoryName": "OST_PipeAccessory",        "action": "ShowOnly" },
        { "kind": "Category", "categoryName": "OST_FlexPipeCurves",       "action": "ShowOnly" },
        { "kind": "Category", "categoryName": "OST_PlumbingFixtures",     "action": "ShowOnly" },
        { "kind": "Category", "categoryName": "OST_Sprinklers",           "action": "ShowOnly" },
        { "kind": "Category", "categoryName": "OST_MechanicalEquipment",  "action": "ShowOnly" },
        { "kind": "Category", "categoryName": "OST_ElectricalEquipment",  "action": "ShowOnly" },
        { "kind": "Category", "categoryName": "OST_ElectricalFixtures",   "action": "ShowOnly" },
        { "kind": "Category", "categoryName": "OST_LightingFixtures",     "action": "ShowOnly" },
        { "kind": "Category", "categoryName": "OST_CableTray",            "action": "ShowOnly" },
        { "kind": "Category", "categoryName": "OST_Conduit",              "action": "ShowOnly" }
      ]
    }
  ]
}
