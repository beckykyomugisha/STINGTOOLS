<?xml version="1.0" encoding="UTF-8"?>
<ids xmlns="http://standards.buildingsmart.org/IDS"
     xmlns:xs="http://www.w3.org/2001/XMLSchema"
     xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     xsi:schemaLocation="http://standards.buildingsmart.org/IDS http://standards.buildingsmart.org/IDS/1.0/ids.xsd">

  <info>
    <title>STING — Cost Management parameter validation</title>
    <copyright>Planscape Limited, 2026</copyright>
    <version>1.0.0</version>
    <description>IDS encoding of format-side rules from shared/ifc/psets/Pset_StingCostManagement.xml. Validates that BOQ and cost data written by BOQCostManager, CostStamp, and BOQPrepForExportCommand are present and correctly typed on model elements.</description>
    <author>info@stingtools.io</author>
    <date>2026-08-05</date>
    <purpose>STING Cost Management substrate validation — cross-host IFC round-trip</purpose>
    <milestone>Stage_4_TechnicalDesign</milestone>
  </info>

  <specifications>

    <specification name="CST_RATE_SOURCE_enumeration"
                   ifcVersion="IFC4"
                   identifier="COST-001"
                   description="When CST_RATE_SOURCE_TXT is present it must be one of the recognised rate-source values."
                   requirementSeverity="optional">
      <applicability>
        <entity>
          <name>
            <simpleValue>IFCELEMENT</simpleValue>
          </name>
        </entity>
        <property>
          <propertySet><simpleValue>Pset_StingCostManagement</simpleValue></propertySet>
          <baseName><simpleValue>CST_RATE_SOURCE_TXT</simpleValue></baseName>
        </property>
      </applicability>
      <requirements>
        <property dataType="IFCLABEL">
          <propertySet><simpleValue>Pset_StingCostManagement</simpleValue></propertySet>
          <baseName><simpleValue>CST_RATE_SOURCE_TXT</simpleValue></baseName>
          <value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="BCIS"/>
              <xs:enumeration value="ProjectCard"/>
              <xs:enumeration value="MaterialLibrary"/>
              <xs:enumeration value="Manual"/>
              <xs:enumeration value="Override"/>
            </xs:restriction>
          </value>
        </property>
      </requirements>
    </specification>

    <specification name="CST_BOQ_UNIT_enumeration"
                   ifcVersion="IFC4"
                   identifier="COST-002"
                   description="When CST_BOQ_UNIT_TXT is present it must be an NRM2-valid measurement unit."
                   requirementSeverity="optional">
      <applicability>
        <entity>
          <name>
            <simpleValue>IFCELEMENT</simpleValue>
          </name>
        </entity>
        <property>
          <propertySet><simpleValue>Pset_StingCostManagement</simpleValue></propertySet>
          <baseName><simpleValue>CST_BOQ_UNIT_TXT</simpleValue></baseName>
        </property>
      </applicability>
      <requirements>
        <property dataType="IFCLABEL">
          <propertySet><simpleValue>Pset_StingCostManagement</simpleValue></propertySet>
          <baseName><simpleValue>CST_BOQ_UNIT_TXT</simpleValue></baseName>
          <value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="nr"/>
              <xs:enumeration value="m"/>
              <xs:enumeration value="m2"/>
              <xs:enumeration value="m3"/>
              <xs:enumeration value="kg"/>
              <xs:enumeration value="t"/>
              <xs:enumeration value="item"/>
            </xs:restriction>
          </value>
        </property>
      </requirements>
    </specification>

  </specifications>

</ids>
