  <info>
    <title>STING — Lightning protection (BS EN 62305) (Pset_StingLightningProtection)</title>
    <copyright>Planscape Limited, 2026</copyright>
    <version>1.0.0</version>
    <description>IDS encoding of shared/ifc/psets/Pset_StingLightningProtection.xml: every property, when present, carries the data type the template declares; the few properties whose values are fixed by a standard or by the code that writes them are also checked for value. One specification per property, in template order.</description>
    <author>info@stingtools.io</author>
    <date>2026-10-02</date>
    <purpose>STING property-set contract validation (DSCH-38 follow-up)</purpose>
    <milestone>Stage_4_TechnicalDesign</milestone>
  </info>

  <specifications>

    <specification name="LightningProtectionClass_type"
                   identifier="LPS-001"
                   description="When Pset_StingLightningProtection.LightningProtectionClass is present it is an IfcLabel; BS EN 62305-1 defines LPS classes I to IV."
                   ifcVersion="IFC4 IFC4X3_ADD2">
      <applicability minOccurs="0" maxOccurs="unbounded">
        <property>
          <propertySet><simpleValue>Pset_StingLightningProtection</simpleValue></propertySet>
          <baseName><simpleValue>LightningProtectionClass</simpleValue></baseName>
        </property>
      </applicability>
      <requirements>
        <property dataType="IFCLABEL" cardinality="required">
          <propertySet><simpleValue>Pset_StingLightningProtection</simpleValue></propertySet>
          <baseName><simpleValue>LightningProtectionClass</simpleValue></baseName>
          <value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="I"/>
              <xs:enumeration value="II"/>
              <xs:enumeration value="III"/>
              <xs:enumeration value="IV"/>
            </xs:restriction>
          </value>
        </property>
      </requirements>
    </specification>

